<?xml version="1.0"?>
<phpunit bootstrap="bootstrap.php" colors="true" failOnRisky="true" failOnWarning="true" convertDeprecationsToExceptions="false">
    <testsuites><testsuite name="verified-updates"><directory suffix="Test.php">tests</directory></testsuite></testsuites>
    <php><const name="WP_RUN_CORE_TESTS" value="0"/><const name="WP_TESTS_MULTISITE" value="1"/></php>
</phpunit>
