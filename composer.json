{
    "name": "sw-newspaper2/sw-newspaper2",
    "description": "sw-newspaper2 - publish PDF newspapers with an automatic cover thumbnail, archive and dFlip integration.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/php-code-coverage": "^10.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "SWNewspaper2\\": "src/"
        }
    },
    "extra": {
        "mozart": {
            "dep_namespace": "SWNewspaper2\\Dependencies\\",
            "dep_directory": "/vendor-prefixed/",
            "classmap_directory": "/vendor-prefixed/",
            "classmap_prefix": "SWNewspaper2_",
            "constant_prefix": "SWNEWSPAPER2_",
            "functions_prefix": "swnewspaper2_",
            "generate_autoloader": true,
            "delete_vendor_directories": true
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs:fix": "phpcbf",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/run.php"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/run.php --coverage"
        ]
    },
    "scripts-descriptions": {
        "test": "Run all regression scenarios (requires WP_ROOT and a disposable database, see tests/README.md).",
        "test:coverage": "Run all scenarios with Xdebug/PCOV, write coverage/clover.xml and fail unless line coverage is > 80 %."
    }
}
